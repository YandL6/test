# ============================
# Hermes VCU Gateway 环境配置
# Phase 3 — SGLang 自部署大模型
# ============================

# --- 服务端口 ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8100

# --- Hermes Agent 配置 ---
# Hermes 安装目录（setup_hermes.sh 会自动克隆到此路径）
HERMES_HOME_DIR=./hermes-agent
# Hermes profile 名称（多配置隔离，默认 default）
HERMES_PROFILE=default

# ===== Phase 3: SGLang 自部署大模型 =====
# LLM Provider — 使用 custom 绕过 Hermes provider router，直接走 OpenAI 兼容端点
HERMES_LLM_PROVIDER=custom
# 模型名称（与 SGLang 启动 --model-path 中的模型对应）
HERMES_LLM_MODEL=qwen3-4b
# API Key — SGLang 默认不鉴权，填任意非空字符串即可
HERMES_LLM_API_KEY=sglang-dummy-key
# SGLang 服务地址（OpenAI 兼容 /v1 端点）
# 本地部署: http://localhost:30000/v1
# Docker 内部: http://host.docker.internal:30000/v1 或 http://<sglang-ip>:30000/v1
HERMES_LLM_BASE_URL=http://localhost:30000/v1

# --- SGLang 连接健康检查 ---
# 健康检查时探测 SGLang /v1/models 端点的超时（秒）
SGLANG_HEALTH_TIMEOUT=5
# 健康检查是否跳过 SGLang 连通性检测（设为 true 时仅检查 Gateway 自身）
SGLANG_HEALTH_SKIP=false

# --- Docker 沙箱配置 ---
HERMES_SANDBOX_BACKEND=docker
HERMES_SANDBOX_IMAGE=python:3.11-slim
HERMES_SANDBOX_TIMEOUT=300

# --- 知识库（RAGFlow）配置 ---
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your-ragflow-api-key

# --- 安全配置 ---
# JWT 密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=change-me-to-a-random-string
# API Token 有效期（小时）
JWT_EXPIRE_HOURS=72
# 允许的 API Tokens（逗号分隔，为空则不启用 Token 认证）
API_TOKENS=

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- 文件上传配置 ---
# 上传文件存储目录
UPLOAD_DIR=./uploads
# 最大上传文件大小（MB）
MAX_UPLOAD_SIZE_MB=50
# 允许的文件类型
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.doc,.xls,.txt,.md
